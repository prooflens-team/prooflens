GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
DATABASE_URL=

# Express 서버
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,https://prooflens-demo.vercel.app
# 비우면 backend/.venv의 Python을 사용합니다.
PYTHON_BIN=
# 비워 두면 종류별 시간을 사용합니다. 값을 두면 종류별 변수가 없는 분석에만 적용됩니다.
# ANALYSIS_TIMEOUT_MS=55000
ANALYSIS_TIMEOUT_TEXT_MS=120000
ANALYSIS_TIMEOUT_YOUTUBE_MS=180000
# 대기열에서 실행이 시작되기까지 기다릴 수 있는 시간입니다. 실행 시간과 따로 계산합니다.
MAX_QUEUE_WAIT_MS=60000
JOB_TTL_MS=1800000
MAX_JOBS=200
MAX_CONCURRENT_ANALYSES=2
MAX_QUEUED_ANALYSES=10
MAX_CONCURRENT_PER_IP=2
MAX_ANALYSIS_CLAIMS=20
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_PER_HOUR=60
RATE_LIMIT_GLOBAL_WINDOW_MS=3600000
RATE_LIMIT_POLL_PER_MINUTE=120
# Railway 프록시 1단. true로 두면 앞쪽 X-Forwarded-For를 위조할 수 있습니다.
TRUST_PROXY_HOPS=1
# 같은 IP의 진행 중 분석을 재사용하지 않습니다. 계정식별이 생기기 전에는 켜지 마세요.
REUSE_IN_PROGRESS_ANALYSIS=false
# 1이면 생성 API와 임베딩 API 호출 횟수만 로그에 남깁니다. 광고 내용과 키는 넣지 않습니다.
PROOFLENS_API_LOG=0
MAX_IMAGE_BYTES=5242880
MAX_IMAGES=5
# 파일 내용 합계입니다. 이미지 5장 x 5MiB. multipart 경계와 텍스트 필드는 이 값에 넣지 않습니다.
MAX_UPLOAD_BYTES=26214400
MAX_FORM_FIELDS=8
MAX_FIELD_BYTES=1000000